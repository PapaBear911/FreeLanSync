{
  "name": "photosync-desktop",
  "version": "1.0.0",
  "description": "PhotoSync Desktop Server System Tray & Window Manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.photosync.desktop",
    "productName": "PhotoSync Server",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
